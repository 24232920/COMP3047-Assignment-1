<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SciFac Events</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>

<body>
    <header class="main-header">
        <div class="container">
            <div class="title">
                <h1 class="title">SciFac Events</h1>
            </div>

            <nav class="main-nav">
                <ul>
                    <li></li>
                    <li></li>
                    <li><a href="/">Home</a></li>
                    <li><a href="/events">Events</a></li>
                    <li><a href="/venues">Venues</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <div class="form-page">
            <h1 class="form-title">Create New Venue</h1>

            <!-- =================== Venue Form =================== -->
            <div class="form-container">
                <form action="/venue/add" method="POST">
                    <div class="form-group.full-width">
                        <label for="venueName" class="col-form-label">Name<span class="required">*</span></label>
                        <input type="text" class="form-control" id="venueName" name="venueName" maxlength="100" required>
                        <br>
                    </div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="venueLocation" class="col-form-label">Location<span
                                    class="required">*</span></label>
                            <input type="text" class="form-control" id="venueLocation" name="venueLocation"
                                placeholder="e.g., Building A, Room 101" required>
                            <br>
                        </div>

                        <div class="form-group">
                            <label for="venueCapacity" class="col-form-label">Capacity<span
                                    class="required">*</span></label>
                            <input type="number" class="form-control" id="venueCapacity" name="venueCapacity" min="1" required>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label for="venueDescription" class="col-form-label">Description</label>
                        <textarea class="form-control" id="venueDescription" name="venueDescription"></textarea>
                        <br>
                    </div>

                    <fieldset>
                        <label for="facilities" class="col-form-label">Facilities</label>

                        <div class="facilities-grid">
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid1"> Projector</label>
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid2"> Whiteboard</label>
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid3"> Microphone</label>

                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid4"> WiFi</label>
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid5"> Air
                                Conditioning</label>
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid6"> Video
                                Conferencing</label>

                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid7"> Sound
                                System</label>
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid8"> Parking</label>
                            <label><input class="form-check-input" type="checkbox" name="facilities" value="on"
                                    id="fGrid9"> Wheelchair
                                Access</label>
                        </div>
                    </fieldset>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Venue</button>
                        <a href="/events" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <p>2026 Science Faculty Event Management System. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SciFac Events</title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>

<body>
  <!-- =========== Header =========== -->

  <header class="main-header">
    <div class="container">
      <div>
        <h1 class="title">SciFac Events</h1>
      </div>

      <nav class="main-nav">
        <ul>
          <li></li>
          <li></li>
          <li><a href="/">Home</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/venues">Venues</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="home-page container py-4">

    <!-- Highlighted events -->
    <section class="mb-4">
      <!-- <h2 class="section-heading">Highlighted Events</h2> -->

      <% if (highlightedEvents.length> 0) { %>
        <div id="highlightedCarousel" class="carousel slide">
          <div class="carousel-inner">
            <% highlightedEvents.forEach(function (event, index) { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <div class="highlight-slide" <% if (event.eventBanner) { %>
                  style="background-image: url('<%= event.eventBanner %>')"
                    <% } %>>
                      <div class="highlight-caption">
                        <h3>
                          <%= event.eventTitle %>
                        </h3>

                        <p>
                          <% if (event.eventDate) { %>
                            <%= new Date(event.eventDate).toLocaleString() %>
                              <% } %>
                                <% if (event.eventVenue) { %>
                                  · <%= event.eventVenue %>
                                    <% } %>
                        </p>

                        <a class="btn btn-primary" href="/event/detail/<%= event._id %>">View
                          Details</a>
                      </div>
                </div>
              </div>
              <% }); %>
          </div>

          <% if (highlightedEvents.length> 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#highlightedCarousel"
              data-bs-slide="prev" aria-label="Previous highlighted event">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#highlightedCarousel"
              data-bs-slide="next" aria-label="Next highlighted event">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
            <% } %>
        </div>
        <% } else { %>
          <p>No highlighted events at the moment.</p>
          <% } %>
    </section>
    <br>

    <!-- Upcoming events -->
    <% const statusUpcomingEvents=(upcomingEvents || []).filter( event=> String(event.status || "").trim().toLowerCase()
      === "upcoming"
      );
      %>

      <section>
        <h2 class="section-heading">Upcoming Events</h2>
        <hr>

        <% if (statusUpcomingEvents.length> 0) { %>
          <div class="row g-3">
            <% statusUpcomingEvents.forEach(function (event) { %>
              <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100">
                  <% if (event.eventBanner) { %>
                    <img class="card-img-top event-card-image" src="<%= event.eventBanner %>"
                      alt="<%= event.eventTitle %>">
                    <% } else { %>
                      <div class="event-card-image event-card-placeholder"></div>
                      <% } %>

                        <div class="card-body d-flex flex-column">
                          <% if (event.category) { %>
                            <span class="badge text-bg-secondary align-self-start mb-2">
                              <%= event.category %>
                            </span>
                            <% } %>

                              <h3 class="card-title">
                                <%= event.eventTitle %>
                              </h3>

                              <p class="event-card-date">
                                <%= new Date(event.eventDate).toLocaleString() %>
                              </p>

                              <a class="btn btn-outline-primary mt-auto"
                                href="/event/detail/<%= event._id %>">Details</a>
                        </div>
                </article>
              </div>
              <% }); %>
          </div>
          <% } else { %>
            <p>No upcoming events at the moment.</p>
            <% } %>
      </section>
      <br><br>

      <!-- Trending events -->
      <section>
        <h2 class="section-heading">Trending Events</h2>
        <hr>

        <% if (highlightedEvents.length> 0) { %>
          <div class="row g-3">
            <% highlightedEvents.forEach(function (event) { %>
              <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100">
                  <% if (event.eventBanner) { %>
                    <img class="card-img-top event-card-image" src="<%= event.eventBanner %>"
                      alt="<%= event.eventTitle %>">
                    <% } else { %>
                      <div class="event-card-image event-card-placeholder"></div>
                      <% } %>

                        <div class="card-body d-flex flex-column">
                          <% if (event.category) { %>
                            <span class="badge text-bg-secondary align-self-start mb-2">
                              <%= event.category %>
                            </span>
                            <% } %>

                              <h3 class="card-title">
                                <%= event.eventTitle %>
                              </h3>

                              <p class="event-card-date">
                                <%= new Date(event.eventDate).toLocaleString() %>
                              </p>

                              <a class="btn btn-outline-primary mt-auto"
                                href="/event/detail/<%= event._id %>">Details</a>
                        </div>
                </article>
              </div>
              <% }); %>
          </div>
          <% } else { %>
            <p>No trending events at the moment.</p>
            <% } %>

      </section>
      <br><br>

      <!-- Recent Events -->
      <section>
        <h2 class="section-heading">Recent Events</h2>
        <hr>

        <% if (latestEvents.length) { %>
          <div class="row g-3">
            <% latestEvents.forEach(function (event) { %>
              <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100">
                  <% if (event.eventBanner) { %>
                    <img class="card-img-top event-card-image" src="<%= event.eventBanner %>"
                      alt="<%= event.eventTitle %>">
                    <% } else { %>
                      <div class="event-card-image event-card-placeholder"></div>
                      <% } %>
                        <div class="card-body d-flex flex-column">
                          <% if (event.category) { %>
                            <span class="badge text-bg-secondary align-self-start mb-2">
                              <%= event.category %>
                            </span>
                            <% } %>

                              <h3 class="card-title">
                                <%= event.eventTitle %>
                              </h3>

                              <p class="event-card-date">
                                <%= new Date(event.eventDate).toLocaleString() %>
                              </p>

                              <a class="btn btn-outline-primary mt-auto"
                                href="/event/detail/<%= event._id %>">Details</a>
                        </div>
                </article>
              </div>
              <% }); %>
          </div>
          <% } else { %>
            <p class="empty-events">No recent events at the moment.</p>
            <% } %>
      </section>


  </main>

  <footer class="site-footer">
    <p>2026 Science Faculty Event Management System. All rights reserved.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


</body>
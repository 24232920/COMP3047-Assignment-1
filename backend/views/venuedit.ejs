<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SciFac Events</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body>
    <header class="main-header">
        <div class="container">
            <div class="title">
                <h1 class="title">SciFac Events</h1>
            </div>

            <nav class="main-nav">
                <ul>
                    <li></li>
                    <li></li>
                    <li><a href="/">Home</a></li>
                    <li><a href="/events">Events</a></li>
                    <li><a href="/venues">Venues</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

        <div class="form-page">
            <div class="edit-form-heading">
                <h1 class="form-title">Edit Venue</h1>

                <form action="/venue/delete/<%= venue._id %>" method="POST">
                    <button type="submit" class="delete-btn">Delete</button>
                </form>
            </div>

            <!-- =================== Venue Form =================== -->
            <div class="form-container">
                <form action="/venue/edit/<%= venue._id %>" method="POST">
                    <div class="form-group.full-width">
                        <label for="venueName" class="col-form-label">Name<span class="required">*</span></label>
                        <input type="text" class="form-control" id="venueName" name="venueName"
                            value="<%= venue.venueName %>" maxlength="100" required>
                        <br>
                    </div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="venueLocation" class="col-form-label">Location<span
                                    class="required">*</span></label>
                            <input type="text" class="form-control" id="venueLocation" name="venueLocation"
                                value="<%= venue.venueLocation %>" required>
                            <br>
                        </div>

                        <div class="form-group">
                            <label for="venueCapacity" class="col-form-label">Capacity<span
                                    class="required">*</span></label>
                            <input type="number" class="form-control" id="venueCapacity" name="venueCapacity"
                                value="<%= venue.venueCapacity %>" min="1" required>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label for="venueDescription" class="col-form-label">Description</label>
                        <textarea class="form-control" id="venueDescription"
                            name="venueDescription"><%= venue.venueDescription %></textarea>
                        <br>
                    </div>

                    <fieldset>
                        <label for="facilities" class="col-form-label">Facilities</label>
                        <% const legacyFacilities=[ ["facilities1", "projector" ], ["facilities2", "whiteboard" ],
                            ["facilities3", "microphone" ], ["facilities4", "wifi" ], ["facilities5", "air-conditioning"
                            ], ["facilities6", "video-conferencing" ], ["facilities7", "sound-system" ],
                            ["facilities8", "parking" ], ["facilities9", "wheelchair-access" ] ]; const
                            facilities=Array.isArray(venue.facilities) ? venue.facilities : legacyFacilities
                            .filter(([key, value])=>
                            venue[key] === value || venue[key] === true || venue[key] === "on"
                            )
                            .map(([, value]) => value);
                            %>


                            <div class="facilities-grid">
                                <label><input type="checkbox" name="facilities" value="projector"
                                        <%=facilities.includes("projector") ? "checked" : "" %>>
                                    Projector</label>
                                <label><input type="checkbox" name="facilities" value="whiteboard"
                                        <%=facilities.includes("whiteboard") ? "checked" : "" %>>
                                    Whiteboard</label>
                                <label><input type="checkbox" name="facilities" value="microphone"
                                        <%=facilities.includes("microphone") ? "checked" : "" %>>
                                    Microphone</label>

                                <label><input type="checkbox" name="facilities" value="wifi"
                                        <%=facilities.includes("wifi") ? "checked" : "" %>> WiFi</label>
                                <label><input type="checkbox" name="facilities" value="air-conditioning"
                                        <%=facilities.includes("air-conditioning") ? "checked" : "" %>> Air
                                    Conditioning</label>
                                <label><input type="checkbox" name="facilities" value="video-conferencing"
                                        <%=facilities.includes("video-conferencing") ? "checked" : "" %>>
                                    Video Conferencing</label>

                                <label><input type="checkbox" name="facilities" value="sound-system"
                                        <%=facilities.includes("sound-system") ? "checked" : "" %>>
                                    Sound System</label>
                                <label><input type="checkbox" name="facilities" value="parking"
                                        <%=facilities.includes("parking") ? "checked" : "" %>>
                                    Parking</label>
                                <label><input type="checkbox" name="facilities" value="wheelchair-access"
                                        <%=facilities.includes("wheelchair-access") ? "checked" : "" %>>
                                    Wheelchair Access</label>
                            </div>
                    </fieldset>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Venue</button>
                        <a href="/events" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <p>2026 Science Faculty Event Management System. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>